# Local development. Production uses a PostgreSQL URL.
DATABASE_URL="file:./dev.db"
ADMIN_TOKEN="change-me-to-a-long-random-token"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
SCRAPER_CONTACT_EMAIL="change-me@example.com"
SCRAPER_DISABLED_SOURCES=""
SCRAPER_ENABLED_SOURCES=""
SCRAPER_PUBLISH_THRESHOLD="0.78"
SCRAPER_FREQUENT_SOURCES="choose-chicago"
SCRAPER_DAILY_SOURCES="dcase,cpl"
GEOCODER_ENABLED="false"
NOMINATIM_EMAIL=""
INCLUDE_SEED_FALLBACK="true"

# Docker Compose only. Use a secret in a real deployment.
POSTGRES_PASSWORD="change-me"
