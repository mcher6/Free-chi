{
  "name": "chifree-radar",
  "version": "0.1.0",
  "private": true,
  "description": "Find Chicago's best free events, pop-ups, giveaways, and appearances.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0 --ignore-pattern .next --ignore-pattern coverage",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "npm run db:generate && npm run db:push && npm run db:seed",
    "db:generate:postgres": "prisma generate --schema prisma/schema.postgresql.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema prisma/schema.postgresql.prisma",
    "scrape": "tsx scripts/scrape.ts",
    "scheduler": "tsx scripts/scheduler.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "cheerio": "1.1.2",
    "leaflet": "1.9.4",
    "lucide-react": "0.468.0",
    "next": "16.2.12",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-leaflet": "5.0.0",
    "sanitize-html": "2.17.6",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/leaflet": "1.9.21",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/sanitize-html": "2.16.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.12",
    "prisma": "6.19.3",
    "tailwindcss": "4.2.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  },
  "type": "module"
}
