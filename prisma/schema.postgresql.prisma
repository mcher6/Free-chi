generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Event {
  id                      String   @id @default(cuid())
  title                   String
  normalizedTitle         String
  description             String
  shortSummary            String
  sourceName              String
  sourceUrl               String
  originalEventUrl        String
  canonicalUrl            String?
  imageUrl                String?
  startDateTime           DateTime
  endDateTime             DateTime?
  timezone                String   @default("America/Chicago")
  venueName               String?
  address                 String?
  neighborhood            String?
  city                    String   @default("Chicago")
  state                   String   @default("IL")
  postalCode              String?
  latitude                Float?
  longitude               Float?
  locationConfidence      Float?
  locationQuality         String   @default("missing")
  organizerName           String?
  organizerType           String?
  registrationRequired    Boolean  @default(false)
  registrationUrl         String?
  priceText               String?
  isFree                  Boolean  @default(false)
  freeConfidence          Float    @default(0)
  freeExplanation         String
  freebieType             Json
  freebieDescription      String?
  freebieAvailability     String   @default("none")
  freebieConfidence       Float    @default(0)
  celebrityNames          Json
  celebrityConfidence     Float    @default(0)
  celebrityLabel          String   @default("none")
  notablePeople           Json
  companyNames            Json
  companyConfidence       Float    @default(0)
  companyInvolvement      Json
  eventCategories         Json
  ageRestriction          String?
  attendanceFormat        String   @default("in_person")
  environment             String   @default("unknown")
  familyFriendly          Boolean  @default(false)
  capacityLimited         Boolean  @default(false)
  status                  String   @default("PUBLISHED")
  firstSeenAt             DateTime @default(now())
  lastSeenAt              DateTime @default(now())
  scrapedAt               DateTime @default(now())
  sourceReliability       Float    @default(0.5)
  uniquenessScore         Float    @default(0.5)
  overallScore            Int      @default(0)
  rankingExplanation      Json
  deduplicationKey        String   @unique
  classificationEvidence  Json
  rawExtractionMetadata   Json?
  isSeed                  Boolean  @default(false)
  seedLabel               String?
  expiredAt               DateTime?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  sourceLinks             EventSourceLink[]

  @@index([startDateTime])
  @@index([status, startDateTime])
  @@index([neighborhood])
  @@index([isFree, freeConfidence])
  @@index([overallScore])
}

model EventSourceLink {
  id               String   @id @default(cuid())
  eventId          String
  sourceName       String
  sourceUrl        String
  originalEventUrl String
  isPrimary        Boolean  @default(false)
  evidence         Json?
  firstSeenAt      DateTime @default(now())
  lastSeenAt       DateTime @default(now())
  event            Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  @@unique([eventId, originalEventUrl])
  @@index([eventId])
}

model ScrapeRun {
  id                String   @id @default(cuid())
  status            String   @default("RUNNING")
  triggeredBy       String   @default("CLI")
  requestedSource   String?
  dryRun            Boolean  @default(false)
  startedAt         DateTime @default(now())
  completedAt       DateTime?
  durationMs        Int?
  fetchedCount      Int      @default(0)
  createdCount      Int      @default(0)
  updatedCount      Int      @default(0)
  rejectedCount     Int      @default(0)
  deduplicatedCount Int      @default(0)
  reviewCount       Int      @default(0)
  errorSummary      String?
  sourceResults     ScrapeSourceResult[]
  @@index([startedAt])
  @@index([status])
}

model ScrapeSourceResult {
  id                String   @id @default(cuid())
  scrapeRunId       String
  sourceKey         String
  sourceName        String
  status            String
  fetchedCount      Int      @default(0)
  createdCount      Int      @default(0)
  updatedCount      Int      @default(0)
  rejectedCount     Int      @default(0)
  deduplicatedCount Int      @default(0)
  reviewCount       Int      @default(0)
  durationMs        Int      @default(0)
  errorMessage      String?
  scrapeRun         ScrapeRun @relation(fields: [scrapeRunId], references: [id], onDelete: Cascade)
  @@index([scrapeRunId])
  @@index([sourceKey])
}

model SourceControl {
  sourceKey          String   @id
  sourceName         String
  enabled            Boolean  @default(true)
  lastAttemptAt      DateTime?
  lastSuccessAt      DateTime?
  lastError          String?
  consecutiveErrors  Int      @default(0)
  averageDurationMs  Int      @default(0)
  updatedAt          DateTime @updatedAt
}

model GeocodeCache {
  id                String   @id @default(cuid())
  addressHash       String   @unique
  normalizedAddress String
  latitude          Float?
  longitude         Float?
  neighborhood      String?
  confidence        Float    @default(0)
  provider          String   @default("nominatim")
  status            String   @default("RESOLVED")
  rawMetadata       Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  @@index([normalizedAddress])
}

model ScrapeLock {
  name        String   @id
  ownerId     String
  acquiredAt  DateTime @default(now())
  lockedUntil DateTime
}
